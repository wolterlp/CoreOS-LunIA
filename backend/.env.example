# ==========================================
# CEREBRO EMPRESARIAL IA - CONFIGURATION
# ==========================================

# --- SERVER & BASE ---
PORT=3000
NODE_ENV=development
APP_NAME="Cerebro Empresarial IA"
FRONTEND_URL="http://localhost:5173"

# --- DATABASE ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://jules:password@localhost:5432/cerebro_db?schema=public"

# --- AUTHENTICATION ---
JWT_SECRET="generate-a-long-random-string-here"
JWT_EXPIRES_IN="7d"
DEFAULT_ADMIN_EMAIL="admin@cerebro.com"

# --- AI CONFIGURATION ---
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_DEFAULT_MODEL="gpt-4o"
AI_MAX_TOKENS=2048

# --- COMMUNICATION CHANNELS ---

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@cerebro.com"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp (e.g., Meta/Twilio)
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Slack
SLACK_WEBHOOK_URL=""

# --- MONITORING & LOGS ---
LOG_LEVEL="info"
